#!/bin/sh

# Optional manual launcher (TTY). SDDM should use start-hyprland directly — see extras/hyprland.desktop.
# Hyprland 0.53+ warns if started as plain "Hyprland" without the start-hyprland watchdog.

# Changing the exports below is not recommended
export WLR_EGL_NO_MODIFIERS=1
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# Add your own exports below this line

# Uncomment for POSSIBLE nvidia support
# See the wiki for more info as some work is required
# https://wiki.hypr.land/Configuring/Environment-variables/
#export LIBVA_DRIVER_NAME=nvidia
#export GBM_BACKEND=nvidia-drm
#export __GLX_VENDOR_LIBRARY_NAME=nvidia
#export WLR_NO_HARDWARE_CURSORS=1

exec start-hyprland
