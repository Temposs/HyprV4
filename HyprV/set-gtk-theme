#!/bin/bash
# Persist GTK theme via config files (works without D-Bus, e.g. during TTY install).
# If a session bus is already available, also sync xfconf and gsettings.
theme="${1:?theme name required}"
icon="${2:?icon theme name required}"

write_gtk_ini() {
    local dir="$1"
    mkdir -p "$dir"
    cat > "$dir/settings.ini" <<EOF
[Settings]
gtk-theme-name=${theme}
gtk-icon-theme-name=${icon}
EOF
}

write_gtk_ini "$HOME/.config/gtk-3.0"
write_gtk_ini "$HOME/.config/gtk-4.0"

if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null
        gsettings set org.gnome.desktop.interface icon-theme "$icon" 2>/dev/null
    fi
    if command -v xfconf-query >/dev/null 2>&1; then
        xfconf-query -c xsettings -p /Net/ThemeName -s "$theme" 2>/dev/null
        xfconf-query -c xsettings -p /Net/IconThemeName -s "$icon" 2>/dev/null
    fi
fi
